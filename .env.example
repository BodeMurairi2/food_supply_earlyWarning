# Copy to .env and fill in. .env is git-ignored; never commit real keys.
OPENROUTER_API_KEY=your-openrouter-key
TAVILY_API_KEY=your-tavily-key
# Any LiteLLM model id; OpenRouter models start with "openrouter/".
HW_LLM_MODEL=openrouter/anthropic/claude-sonnet-5.5
# Tavily search depth: basic (cheaper) or advanced (better results, uses more credits).
SEARCH_DEPTH=basic
