# HTTPS for HarvestWatch. Caddy gets and renews the Let's Encrypt certificate by itself,
# and redirects http:// to https://. DOMAIN comes from docker-compose.yml.
{
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy harvestwatch:8000 {
		transport http {
			# An AI answer can take several minutes, including its repair step.
			response_header_timeout 10m
		}
	}
}
